<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>OldenEra.MatchFinder</AssemblyName>
    <Version>0.1.3</Version>
    <Description>Звуковое уведомление о найденном матче в Heroes of Might and Magic: Olden Era.</Description>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>$(GameRoot)\BepInEx\core\BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(GameRoot)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameRoot)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(GameRoot)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Hex.Shared"><HintPath>$(GameRoot)\BepInEx\interop\Hex.Shared.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(GameRoot)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\match-found.wav" LogicalName="MatchFinder.MatchFound.wav" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameRoot)\BepInEx\interop\Hex.Shared.dll')" Text="Не найдены библиотеки игры. Передайте -p:GameRoot=путь_к_игре с установленным BepInEx 6 IL2CPP." />
  </Target>
</Project>
